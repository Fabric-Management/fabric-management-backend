<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter xmlns="https://github.com/spotbugs/filter/4.0.0">
    <!--
      Exclude classes that trigger FindSecBugs SpringEntityLeakDetector bug:
      generic return types (Map<String,Object>, ApiResponse<Map<...>>) cause
      IllegalArgumentException in the detector; build still succeeds but log is noisy.
    -->
    <Match>
        <Class name="com.fabricmanagement.common.infrastructure.web.HealthController"/>
    </Match>
    <Match>
        <Class name="com.fabricmanagement.common.platform.dev.DevelopmentToolsController"/>
    </Match>
    <!--
      TASK-TEMPLATE-TENANCY-1: MD5 here is a non-cryptographic content fingerprint.
      It must equal the PostgreSQL md5() expression used by migration
      V20260926100100 and the INV-RECIPE-TASK-1 inventory; it guards no secret.
      Narrowed to this one class and this one bug pattern.
    -->
    <Match>
        <Class name="com.fabricmanagement.flowboard.generator.domain.catalogue.TaskTemplateCatalogue"/>
        <Bug pattern="WEAK_MESSAGE_DIGEST_MD5"/>
    </Match>
</FindBugsFilter>
